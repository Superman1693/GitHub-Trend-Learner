# GitHub-Trend-Learner 配置样例：复制为 .env 并填写。敏感信息不进文档与日志（NFR6）。

# ---- GitHub（可选）：不配置时受未认证限流 60 次/小时 ----
# GITHUB_TOKEN=ghp_xxx

# ---- LLM（内容生成必需）：OpenAI 兼容接口三要素 ----
# GLM 示例：LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4   LLM_MODEL=glm-4-flash
# DeepSeek 示例：LLM_BASE_URL=https://api.deepseek.com          LLM_MODEL=deepseek-chat
# Ollama 示例：LLM_BASE_URL=http://127.0.0.1:11434/v1           LLM_MODEL=qwen2.5:7b
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# ---- SMTP 邮件（可选）：不配置时每日任务仅归档不发信（Req1.9 兜底） ----
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
MAIL_TO=

# ---- 运行参数（可选） ----
# TRENDING_TOP_N：每日「自动解析」的仓库数（每个都会调用 LLM，谨慎放大）
TRENDING_TOP_N=10
# CANDIDATE_POOL_SIZE：发现页候选池规模（仅抓取+打标+翻译，零 LLM 成本）
CANDIDATE_POOL_SIZE=60
CONCURRENCY=3
